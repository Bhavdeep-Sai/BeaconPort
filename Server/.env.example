# Server Environment Variables Template
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/beaconport
JWT_SECRET=your_jwt_secret_min_32_chars_placeholder
FRONTEND_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id_placeholder

# Email Notifications (Nodemailer)
EMAIL_USER=noreply@example.com
EMAIL_PASSWORD=your_email_app_password

# Cloudinary Cloud Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini AI Tutor
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Background Jobs / Cron
ENABLE_IN_PROCESS_CRON=false
