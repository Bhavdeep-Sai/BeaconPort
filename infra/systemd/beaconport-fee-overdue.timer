[Unit]
Description=BeaconPort Scheduled Job Timer: Daily 01:00 UTC Overdue Fee Marking
Requires=beaconport-fee-overdue.service

[Timer]
# Trigger daily at 01:00:00 UTC
OnCalendar=*-*-* 01:00:00 UTC
# Run immediately upon boot if a scheduled event was missed during downtime
Persistent=true
# Apply minor randomized delay (up to 5 minutes) to avoid resource spikes
RandomizedDelaySec=300

[Install]
WantedBy=timers.target

