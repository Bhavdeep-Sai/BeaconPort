# ==============================================================================
# BeaconPort Infrastructure Variables Template (terraform.tfvars.example)
#
# Copy this file to terraform.tfvars and customize for your environment:
#   cp terraform.tfvars.example terraform.tfvars
#
# DO NOT commit terraform.tfvars to version control if it contains custom values.
# ==============================================================================

aws_region            = "us-east-1"
environment           = "production"
project_name          = "beaconport"
vpc_cidr              = "10.0.0.0/16"
public_subnet_cidrs   = ["10.0.1.0/24", "10.0.2.0/24"]
instance_type         = "t3.micro"
github_repo           = "Bhavdeep-Sai/BeaconPort"
ecr_repository_name   = "beaconport-api"
log_retention_in_days = 14

